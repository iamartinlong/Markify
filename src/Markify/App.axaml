<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Markify.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="EditorBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="EditorForeground" Color="#1F2328" />
                    <SolidColorBrush x:Key="ChromeBackground" Color="#F6F8FA" />
                    <SolidColorBrush x:Key="ChromeBorder" Color="#D8DEE4" />
                    <SolidColorBrush x:Key="PreviewBackground" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="EditorBackground" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="EditorForeground" Color="#D4D4D4" />
                    <SolidColorBrush x:Key="ChromeBackground" Color="#252526" />
                    <SolidColorBrush x:Key="ChromeBorder" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="PreviewBackground" Color="#0D1117" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- AvaloniaEdit 必需：编辑器模板与滚动条样式 -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- MarkView 必需：MarkdownViewer 模板（文档滚动依赖它，缺失时无法滚动） -->
        <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />
        <!-- 可选预设：GitHub 外观 -->
        <StyleInclude Source="avares://MarkView.Avalonia/Themes/GitHubTheme.axaml" />

        <Style Selector="Border.chrome">
            <Setter Property="Background" Value="{DynamicResource ChromeBackground}" />
        </Style>
        <Style Selector="Border.statusbar">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorder}" />
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <!--
          MarkView 的滚动条浮在文档内容之上，不为自身预留宽度：
          文档内容会一直画到 ScrollViewer 右边缘，于是表格边框正好压在滚动条上（实测重合 2px）。
          给文档根元素（Grid.markdown-document）加右外边距，把内容收窄到滚动条左侧。
          放在文档级而不是容器 Border 的 Padding 上，是因为容器 padding 会连同滚动条一起内缩，
          两者相对位置不变，问题依旧。
        -->
        <Style Selector="Grid.markdown-document">
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- 文档标签：非活动态半透明，活动态用主题强调色底 -->
        <Style Selector="Border.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2,2,2,2" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style Selector="Border.tab.active">
            <Setter Property="Background" Value="{DynamicResource PreviewBackground}" />
        </Style>
        <Style Selector="Border.tab Button.tab-title">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.tab.active Button.tab-title">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- 侧栏页签（文件 / 大纲） -->
        <Style Selector="Button.side-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.side-tab.active">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.side-icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.tab Button.tab-close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.tab Button.tab-close:pointerover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="#40FF0000" />
        </Style>
    </Application.Styles>
</Application>
