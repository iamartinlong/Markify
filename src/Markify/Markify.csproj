<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Markify</AssemblyName>
    <RootNamespace>Markify</RootNamespace>

    <!--
      exe 内嵌图标（资源管理器 / 任务栏 / 文件关联都用它）。
      注意 Avalonia 的 Window.Icon 只影响运行时的窗口，不会写入 exe，
      两者必须分别设置。
    -->
    <ApplicationIcon>Assets\markify-logo.ico</ApplicationIcon>

    <!-- 版本由 CI/CD 通过 -p:Version 覆盖；本地构建用这个默认值。 -->
    <Version>0.1.0</Version>
    <Product>Markify</Product>
    <Description>Lightweight Markdown editor and preview client built on Avalonia.</Description>

    <!-- NativeAOT 元数据：明确声明可裁剪/AOT 兼容，并保留 XAML 反射所需信息。 -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="MarkView.Avalonia" Version="12.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MarkView.Avalonia.SyntaxHighlighting" Version="12.4.0" />
  </ItemGroup>
</Project>
