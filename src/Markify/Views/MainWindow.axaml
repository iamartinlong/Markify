<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Markify.ViewModels"
        xmlns:services="using:Markify.Services"
        xmlns:views="using:Markify.Views"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:mv="using:MarkView.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Markify.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/markify-logo.ico"
        Width="1280" Height="820"
        MinWidth="640" MinHeight="400"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <views:HeadingLevelToMarginConverter x:Key="LevelToMargin" />
        <views:FolderIconConverter x:Key="FolderIcon" />
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding TogglePreviewCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExportHtmlCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+D" Command="{Binding ExportPdfCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FindCommand}" />
        <!-- Ctrl+H 不在这里绑定：AvaloniaEdit 的 TextArea 会先消费该组合键，
             窗口级 KeyBinding 反而会把它标记为已处理，导致编辑器内部的 Tunnel 处理器收不到。
             实际处理见 MainWindow.OnEditorKeyDown。 -->
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- 菜单 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="打开…" Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="打开文件夹…" Command="{Binding OpenFolderCommand}" InputGesture="Ctrl+Shift+O" />
                <MenuItem Header="关闭文件夹" Command="{Binding CloseFolderCommand}" />
                <Separator />
                <MenuItem Header="保存" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="另存为…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="导出为 HTML…" Command="{Binding ExportHtmlCommand}" InputGesture="Ctrl+Shift+E" />
                <MenuItem Header="导出为 PDF…" Command="{Binding ExportPdfCommand}" InputGesture="Ctrl+Shift+D"
                          IsEnabled="{Binding CanExportPdf}"
                          ToolTip.Tip="PDF 导出依赖系统 Edge 或 Chrome" />
                <Separator />
                <MenuItem Header="退出" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="查找…" Command="{Binding FindCommand}" InputGesture="Ctrl+F" />
                <MenuItem Header="查找并替换…" Command="{Binding ReplaceCommand}" InputGesture="Ctrl+H" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="显示预览" ToggleType="CheckBox" IsChecked="{Binding IsPreviewVisible}" />
                <MenuItem Header="自动换行" ToggleType="CheckBox" IsChecked="{Binding IsWordWrap}" />
                <MenuItem Header="行号" ToggleType="CheckBox" IsChecked="{Binding ShowLineNumbers}" />
                <Separator />
                <MenuItem Header="显示大纲" ToggleType="CheckBox" IsChecked="{Binding IsOutlineVisible}" />
                <MenuItem Header="纵向分栏" ToggleType="CheckBox" IsChecked="{Binding IsVerticalSplit}" />
                <MenuItem Header="深色主题" ToggleType="CheckBox" IsChecked="{Binding IsDarkTheme}" />
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top" Classes="chrome" BorderThickness="0,1,0,1"
                BorderBrush="{DynamicResource ChromeBorder}" Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="新建" Command="{Binding NewDocumentCommand}" />
                <Button Content="打开" Command="{Binding OpenDocumentCommand}" />
                <Button Content="保存" Command="{Binding SaveCommand}" />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ChromeBorder}" />
                <Button Content="加粗" Click="OnBoldClick" ToolTip.Tip="Ctrl+B" />
                <Button Content="斜体" Click="OnItalicClick" ToolTip.Tip="Ctrl+I" />
                <Button Content="链接" Click="OnLinkClick" ToolTip.Tip="Ctrl+K" />
                <Button Content="代码" Click="OnCodeClick" ToolTip.Tip="Ctrl+`" />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ChromeBorder}" />
                <ToggleButton Content="预览" IsChecked="{Binding IsPreviewVisible}" />
                <ToggleButton Content="大纲" IsChecked="{Binding IsOutlineVisible}" />
                <ToggleButton Content="换行" IsChecked="{Binding IsWordWrap}" />
                <ToggleButton Content="深色" IsChecked="{Binding IsDarkTheme}" />
            </StackPanel>
        </Border>

        <!-- 标签栏：每个文档一个标签，关闭按钮在标签上 -->
        <Border DockPanel.Dock="Top" Classes="chrome" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ChromeBorder}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Documents}" Margin="6,4,6,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentViewModel">
                            <Border Classes="tab" Classes.active="{Binding IsActive}"
                                    CornerRadius="4,4,0,0"
                                    ToolTip.Tip="{Binding TabToolTip}"
                                    PointerPressed="OnTabPointerPressed">
                                <Border.ContextMenu>
                                    <!--
                                      ContextMenu 不在视觉树里：`$parent[ItemsControl]` 解析不到，
                                      PlacementTarget 在 Opening 时也已是 null（均实测确认）。
                                      因此改为在 PointerPressed 时记录被右键的标签，各菜单项从这里取。
                                    -->
                                    <ContextMenu x:Name="TabContextMenu" Opening="OnTabContextMenuOpening">
                                        <MenuItem Header="保存" Click="OnTabMenuSave" />
                                        <MenuItem Header="另存为…" Click="OnTabMenuSaveAs" />
                                        <Separator />
                                        <MenuItem Header="打开所在文件夹" Click="OnTabMenuReveal" />
                                        <MenuItem Header="复制文件路径" Click="OnTabMenuCopyPath" />
                                        <Separator />
                                        <MenuItem Header="关闭左侧标签" Click="OnTabMenuCloseLeft" />
                                        <MenuItem Header="关闭右侧标签" Click="OnTabMenuCloseRight" />
                                        <MenuItem Header="关闭其他标签" Click="OnTabMenuCloseOthers" />
                                        <Separator />
                                        <MenuItem Header="关闭" Click="OnTabMenuClose" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="tab-title"
                                            Content="{Binding TabTitle}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ActivateDocumentCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="tab-close"
                                            Content="✕"
                                            ToolTip.Tip="关闭标签 (Ctrl+W)"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Classes="chrome statusbar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding CaretDisplay}" />
                    <TextBlock Text="{Binding ActiveDocument.WordCount, StringFormat='字数 {0}'}" />
                    <TextBlock Text="{Binding ActiveDocument.CharCount, StringFormat='字符 {0}'}" />
                    <TextBlock Text="{Binding ActiveDocument.EncodingName}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：大纲 + 编辑区 + 预览区（可切换左右/上下分栏） -->
        <Grid x:Name="SplitRoot" ColumnDefinitions="Auto,*">
            <!-- 左侧大纲栏 -->
            <Border x:Name="OutlineHost" Grid.Column="0" Width="220"
                    Classes="chrome"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource ChromeBorder}"
                    IsVisible="{Binding IsOutlineVisible}">
                <DockPanel>
                    <!-- 侧栏页签：文件树 / 大纲，同一时刻只显示一个 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="8,8,8,4">
                        <Button Content="文件" Classes="side-tab"
                                Classes.active="{Binding IsFileTreeActive}"
                                Command="{Binding ShowFileTreeCommand}" />
                        <Button Content="大纲" Classes="side-tab"
                                Classes.active="{Binding IsOutlineActive}"
                                Command="{Binding ShowOutlineCommand}" />
                        <Button Content="📂" Classes="side-icon" ToolTip.Tip="打开文件夹…"
                                Command="{Binding OpenFolderCommand}"
                                HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- 文件树 -->
                    <DockPanel IsVisible="{Binding IsFileTreeActive}">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding FolderPath}"
                                   Margin="12,2,12,6" FontSize="11" Opacity="0.6"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding FolderPath, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock DockPanel.Dock="Top" Text="尚未打开文件夹"
                                   Margin="12,8" Opacity="0.55" FontSize="12"
                                   IsVisible="{Binding FolderRoot, Converter={x:Static ObjectConverters.IsNull}}" />
                        <TreeView x:Name="FileTree"
                                  ItemsSource="{Binding FolderRoot.Children}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsVisible="{Binding FolderPath, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}"
                                                  x:DataType="vm:FileTreeNode">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding IsDirectory, Converter={StaticResource FolderIcon}}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <!-- 大纲 -->
                    <ListBox x:Name="OutlineList"
                             IsVisible="{Binding IsOutlineActive}"
                             ItemsSource="{Binding ActiveDocument.Outline}"
                             SelectedItem="{Binding ActiveDocument.SelectedHeading}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="services:MarkdownHeading">
                                <TextBlock Text="{Binding Text}"
                                           Margin="{Binding Level, Converter={StaticResource LevelToMargin}}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid x:Name="EditorPreviewGrid" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- 与 ApplyPaneLayout() 保持一致：左右分栏时预览行与分割条高度为 0，
                         MinHeight 也必须是 0，否则空行会被撑出可见高度（底部多出一条空白）。 -->
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="0" MinHeight="0" />
                    <RowDefinition Height="0" MinHeight="0" />
                </Grid.RowDefinitions>

                <Border x:Name="EditorHost" Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource EditorBackground}">
                    <ae:TextEditor x:Name="Editor"
                                   ShowLineNumbers="{Binding ShowLineNumbers}"
                                   WordWrap="{Binding IsWordWrap}"
                                   FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                   FontSize="14"
                                   Background="Transparent"
                                   Padding="8,0,0,0" />
                </Border>

                <GridSplitter x:Name="Splitter"
                              Grid.Row="0" Grid.Column="1"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ChromeBorder}" />

                <Border x:Name="PreviewHost" Grid.Row="0" Grid.Column="2"
                        Background="{DynamicResource PreviewBackground}"
                        ClipToBounds="True"
                        Padding="24,16,0,16"
                        IsVisible="{Binding IsPreviewVisible}">
                    <mv:MarkdownViewer x:Name="Preview"
                                       Markdown="{Binding ActiveDocument.PreviewMarkdown}"
                                       IsLazyRenderingEnabled="True"
                                       IsSmoothScrollingEnabled="True"
                                       ShowCodeBlockLanguage="True"
                                       ShowCodeBlockCopyButton="True"
                                       AreTaskListsInteractive="True" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
